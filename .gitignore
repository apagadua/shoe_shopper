goat_galleries.json
scraped_galleries.json

# Coverage data (binary; regenerated by pytest --cov)
.coverage

# Marketing build outputs (large binaries; rebuilt by marketing/build.ps1)
marketing/*.mp4

# Local MCP server config (developer-specific, not project config)
.mcp.json

# Claude Code local config and task specs (developer-specific)
.claude/
