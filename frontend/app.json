{
  "expo": {
    "owner": "shoeshopper",
    "name": "shoe_shopper",
    "slug": "shoe_shopper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "entryPoint": "./App.js",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F0"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#FFF8F0"
      },
      "package": "com.alyssapagaduan.shoe_shopper"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "shoeshopper",
    "plugins": [
      "./plugins/withARCore",
      "expo-font",
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Shoe Shopper needs camera access to capture a photo of your foot for sizing."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "a757b766-d179-42f2-b1e2-7c6c279cde67"
      }
    }
  }
}
